{
  "name": "ui-ui-color-palette",
  "version": "3.7.1",
  "private": true,
  "description": "A unified UI component library for color palette functionality across multiple design platforms. This project serves as a common UI foundation that adapts to different platforms (Figma, Penpot, Sketch) while maintaining a consistent experience.",
  "author": "Aurélien Grimaud",
  "license": "MIT",
  "repository": "https://github.com/a-ng-d/ui-ui-color-palette",
  "type": "module",
  "exports": {
    "./types": {
      "types": "./dist/types/types/index.d.ts",
      "default": "./src/types/index.ts"
    },
    "./global-config": {
      "types": "./dist/types/global.config.d.ts",
      "default": "./src/global.config.ts"
    },
    "./config": {
      "types": "./dist/types/config/index.d.ts",
      "default": "./src/config/index.ts"
    },
    "./stores": {
      "types": "./dist/types/stores/index.d.ts",
      "default": "./src/stores/index.ts"
    },
    "./ui/components": {
      "types": "./dist/types/ui/components/index.d.ts",
      "default": "./src/ui/components/index.ts"
    },
    "./ui/contexts": {
      "types": "./dist/types/ui/contexts/index.d.ts",
      "default": "./src/ui/contexts/index.ts"
    },
    "./ui/modes": {
      "types": "./dist/types/ui/modes/index.d.ts",
      "default": "./src/ui/modes/index.ts"
    },
    "./ui/modules": {
      "types": "./dist/types/ui/modules/index.d.ts",
      "default": "./src/ui/modules/index.ts"
    },
    "./ui/services": {
      "types": "./dist/types/ui/services/index.d.ts",
      "default": "./src/ui/services/index.ts"
    },
    "./ui/subcontexts": {
      "types": "./dist/types/ui/subcontexts/index.d.ts",
      "default": "./src/ui/subcontexts/index.ts"
    },
    "./ui/subservices": {
      "types": "./dist/types/ui/subservices/index.d.ts",
      "default": "./src/ui/subservices/index.ts"
    },
    "./ui/stylesheets/*": "./src/ui/stylesheets/*",
    "./external/auth": {
      "types": "./dist/types/external/auth/index.d.ts",
      "default": "./src/external/auth/index.ts"
    },
    "./external/cms": {
      "types": "./dist/types/external/cms/index.d.ts",
      "default": "./src/external/cms/index.ts"
    },
    "./external/license": {
      "types": "./dist/types/external/license/index.d.ts",
      "default": "./src/external/license/index.ts"
    },
    "./external/mistral": {
      "types": "./dist/types/external/mistral/index.d.ts",
      "default": "./src/external/mistral/index.ts"
    },
    "./external/monitoring": {
      "types": "./dist/types/external/monitoring/index.d.ts",
      "default": "./src/external/monitoring/index.ts"
    },
    "./external/onboarding": {
      "types": "./dist/types/external/onboarding/index.d.ts",
      "default": "./src/external/onboarding/index.ts"
    },
    "./external/publication": {
      "types": "./dist/types/external/publication/index.d.ts",
      "default": "./src/external/publication/index.ts"
    },
    "./external/tracking": {
      "types": "./dist/types/external/tracking/index.d.ts",
      "default": "./src/external/tracking/index.ts"
    },
    "./external/transactional": {
      "types": "./dist/types/external/transactional/index.d.ts",
      "default": "./src/external/transactional/index.ts"
    },
    "./external/translation": {
      "types": "./dist/types/external/translation/index.d.ts",
      "default": "./src/external/translation/index.ts"
    },
    "./utils/isValidPaletteConfiguration": {
      "types": "./dist/types/utils/isValidPaletteConfiguration.d.ts",
      "default": "./src/utils/isValidPaletteConfiguration.ts"
    },
    "./translations/*": "./src/content/translations/*"
  },
  "workspaces": [
    "packages/announcements-yelbolt-worker",
    "packages/auth-yelbolt-worker",
    "packages/auth-yelbolt",
    "packages/auth-yelbolt/ui-color-palette",
    "packages/cors-yelbolt-worker"
  ],
  "scripts": {
    "init:submodules": "cd packages/ui-ui-color-palette && git submodule update --init --recursive",
    "install:ext": "npm install --workspaces && npm install --workspace=packages/auth-yelbolt --workspaces && npm install --prefix packages/auth-yelbolt/ui-color-palette",
    "update:unoff": "npm i @unoff/ui@latest @unoff/utils@latest",
    "update:uicp": "npm i @yelbolt/engine-ui-color-palette@latest",
    "link:unoff": "npm link ../../unoff/unoff-utils && npm link ../../unoff/unoff-ui && rm -rf node_modules/.vite",
    "unlink:unoff": "npm unlink @unoff/ui @unoff/utils --no-save && npm install && rm -rf node_modules/.vite",
    "start:announcements": "npm run start:8888 -w announcements-yelbolt-worker",
    "start:token": "npm run start:8787 -w auth-yelbolt-worker",
    "start:cors": "npm run start:8989 -w cors-yelbolt-worker",
    "start:auth": "npm run dev:uicp -w auth-yelbolt",
    "start:ext": "npm run start:announcements & npm run start:token & npm run start:cors & npm run start:auth",
    "poststart:announcements": "npm run clean:port:8888",
    "poststart:token": "npm run clean:port:8787",
    "poststart:cors": "npm run clean:port:8989",
    "poststart:auth": "npm run clean:port:3000",
    "poststart:ext": "npm run clean:port:8888 & npm run clean:port:8787 & npm run clean:port:8989 & npm run clean:port:3000",
    "start:figma:light:figma": "PLATFORM=figma COLOR_MODE=light EDITOR=figma vite --mode development",
    "start:figma:dark:figma": "PLATFORM=figma COLOR_MODE=dark EDITOR=figma vite --mode development",
    "start:figma:light:dev": "PLATFORM=figma COLOR_MODE=light EDITOR=dev vite --mode development",
    "start:figma:dark:dev": "PLATFORM=figma COLOR_MODE=dark EDITOR=dev vite --mode development",
    "start:figma:light:figjam": "PLATFORM=figma COLOR_MODE=light EDITOR=figjam vite --mode development",
    "start:figma:dark:figjam": "PLATFORM=figma COLOR_MODE=dark EDITOR=figjam vite --mode development",
    "start:figma:light:buzz": "PLATFORM=figma COLOR_MODE=light EDITOR=buzz vite --mode development",
    "start:figma:dark:buzz": "PLATFORM=figma COLOR_MODE=dark EDITOR=buzz vite --mode development",
    "start:penpot:light:penpot": "PLATFORM=penpot COLOR_MODE=light EDITOR=penpot vite --mode development",
    "start:penpot:dark:penpot": "PLATFORM=penpot COLOR_MODE=dark EDITOR=penpot vite --mode development",
    "start:sketch:light:sketch": "PLATFORM=sketch COLOR_MODE=light EDITOR=sketch vite --mode development",
    "start:sketch:dark:sketch": "PLATFORM=sketch COLOR_MODE=dark EDITOR=sketch vite --mode development",
    "start:framer:light:framer": "PLATFORM=framer COLOR_MODE=light EDITOR=framer vite --mode development",
    "start:framer:dark:framer": "PLATFORM=framer COLOR_MODE=dark EDITOR=framer vite --mode development",
    "build": "PLATFORM=figma COLOR_MODE=dark EDITOR=figma vite build --mode production",
    "build:types": "tsc -p tsconfig.declarations.json || true",
    "typecheck": "npx tsc --noEmit",
    "lint": "npx eslint ./src --fix --ext .ts,.tsx",
    "format": "npx prettier './src' --write",
    "clean:port:8888": "lsof -ti:8888 | xargs kill -9 2>/dev/null || true",
    "clean:port:8787": "lsof -ti:8787 | xargs kill -9 2>/dev/null || true",
    "clean:port:8989": "lsof -ti:8989 | xargs kill -9 2>/dev/null || true",
    "clean:port:3000": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@sentry/vite-plugin": "^3.3.1",
    "@types/chroma-js": "^3.1.1",
    "@types/file-saver": "^2.0.5",
    "@types/mixpanel-browser": "^2.66.0",
    "@types/node": "^22.14.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-react": "^7.25.3",
    "prettier": "^3.2.5",
    "prettier-plugin-css-order": "^2.1.2",
    "typescript": "^5.4.3",
    "undici": "^7.24.3",
    "vite": "^6.2.5",
    "vite-plugin-environment": "^1.1.3",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "dependencies": {
    "@mistralai/mistralai": "^1.10.0",
    "@nanostores/preact": "^0.5.2",
    "@polar-sh/checkout": "^0.2.0",
    "@polar-sh/sdk": "^0.47.0",
    "@polar-sh/supabase": "^0.4.4",
    "@sentry/react": "^9.27.0",
    "@supabase/supabase-js": "^2.44.2",
    "@tolgee/format-icu": "^6.2.7",
    "@tolgee/react": "^6.2.7",
    "@tolgee/web": "^6.2.7",
    "@unoff/ui": "^1.26.2",
    "@unoff/utils": "^0.9.0",
    "@yelbolt/engine-ui-color-palette": "^1.12.1",
    "chroma-js": "^3.1.2",
    "color-names": "^2.0.0",
    "driver.js": "^1.4.0",
    "fflate": "^0.8.2",
    "file-saver": "^2.0.5",
    "mixpanel-browser": "^2.65.0",
    "preact": "^10.6.4",
    "react-syntax-highlighter": "^15.6.1",
    "uid": "^2.0.2",
    "zod": "^4.3.6"
  },
  "overrides": {
    "prismjs": "^1.30.0",
    "miniflare": {
      "undici": "^7.24.3"
    },
    "postcss": ">=8.5.10",
    "next": {
      "postcss": ">=8.5.10"
    }
  }
}
